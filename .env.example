PORT=3222
DB_PATH=./db/portfolio.sqlite
NODE_ENV=development
# Copy this file to .env and replace every placeholder. Never commit .env.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Correct-horse-battery-staple1
# Optional legacy aliases accepted by npm run seed:
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
SESSION_SECRET=generate-a-long-random-secret-at-least-32-characters
CORS_ORIGIN=
UPLOADS_DIR=./uploads
APP_URL=http://localhost:3222
API_URL=http://localhost:3222
# Use an object-storage adapter in production; local storage is suitable only for development.
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_URL=
MEDIA_STORAGE_KEY=
MEDIA_STORAGE_SECRET=
# SMTP is required to deliver forgot-password email in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
